---
// Placeholder page for build-order step 1: queries every collection so the
// build exercises the full validation layer end-to-end. Replaced by the real
// landing page in step 2.
import { getCollection, getEntry } from 'astro:content';

// Hard rule (SITE_SPEC.md §3): only visibility === 'public' reaches output.
const projects = (
  await getCollection('projects', ({ data }) => data.visibility === 'public')
).sort((a, b) => b.data.start.localeCompare(a.data.start));

const experience = (
  await getCollection('experience', ({ data }) => data.visibility === 'public')
).sort((a, b) => b.data.start.localeCompare(a.data.start));

const about = await getEntry('profile', 'about');
const skills = await getEntry('skills', 'skills');
if (!about || !skills) throw new Error('profile/about.md or profile/skills.yaml missing');
const name = 'name' in about.data ? about.data.name : 'Portfolio';

const featured = projects.filter((p) => p.data.featured);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{name} — Portfolio (scaffold)</title>
  </head>
  <body>
    <main>
      <h1>{name}</h1>
      <p>
        Content-collection wiring check — {projects.length} public projects
        ({featured.length} featured), {experience.length} public experience
        entries, {Object.keys(skills.data).length} skill categories.
      </p>

      <section>
        <h2>Projects</h2>
        <ul>
          {projects.map((p) => (
            <li>
              {p.data.name} — {p.data.start} → {p.data.end}
              {p.data.featured && ' ★'}
            </li>
          ))}
        </ul>
      </section>

      <section>
        <h2>Experience</h2>
        <ul>
          {experience.map((e) => (
            <li>
              {e.data.company} — {e.data.title} ({e.data.start || '?'} →{' '}
              {e.data.end || '?'})
            </li>
          ))}
        </ul>
      </section>
    </main>
  </body>
</html>
