---
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ProjectsSection from '../components/ProjectsSection.astro';
import Timeline from '../components/Timeline.astro';
import Skills from '../components/Skills.astro';
import { aboutEntry, featuredProjects } from '../lib/data';

const about = await aboutEntry();
const { Content: Bio } = await render(about);
const featured = await featuredProjects();
const title = `${about.data.name} — ${about.data.headline}`;
---

<Base title={title} description={about.data.headline}>
  <Hero />

  <section class="container about" id="about" aria-labelledby="about-heading">
    <h2 id="about-heading">About</h2>
    <Bio />
  </section>

  <section class="container" id="experience" aria-labelledby="experience-heading">
    <h2 id="experience-heading">Experience</h2>
    <Timeline />
  </section>

  <section class="container" aria-labelledby="featured-heading">
    <h2 id="featured-heading">Featured projects</h2>
    <div class="featured-grid">
      {featured.map((p) => <ProjectCard project={p} />)}
    </div>
  </section>

  <section class="container" id="projects" aria-labelledby="projects-heading">
    <h2 id="projects-heading">All projects</h2>
    <ProjectsSection />
  </section>

  <section class="container" id="skills" aria-labelledby="skills-heading">
    <h2 id="skills-heading">Skills</h2>
    <Skills />
  </section>
</Base>

<style>
  .featured-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }

  @media (min-width: 640px) {
    .featured-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .about {
    max-width: 760px;
  }
</style>
